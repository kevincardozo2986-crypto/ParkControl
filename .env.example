PORT=3000
# Orígenes permitidos por CORS (separados por coma). 5173 = frontend Vite.
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# API Keys: SOLO para integraciones privadas (Postman, móvil, /api/seguridad, registro).
# Nunca colocarlas en el frontend.
API_KEY_POSTMAN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_ADMIN=REEMPLAZAR_CON_API_KEY_SEGURA
API_KEY_MOVIL=REEMPLAZAR_CON_API_KEY_SEGURA

JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_SEGURO
JWT_EXPIRES_IN=1h

TARIFA_POR_HORA=3000

# Solicitudes por IP cada 15 min en /api (por defecto 300)
# RATE_LIMIT_MAX=300

# Bootstrap del primer administrador: npm run seed:admin
ADMIN_NOMBRE=Administrador ParkControl
ADMIN_EMAIL=admin@parkcontrol.com
ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# Conexión PostgreSQL (Supabase). Use DATABASE_URL o las variables DB_*.
# TLS verificado si existe certs/prod-ca-2021.crt (CA de Supabase).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:6543/postgres
# DB_HOST=
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSL=true
